root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2
max_line_length = 80

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
max_line_length = off

[*.spec]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 2

[*.{service,timer,socket,path,mount}]
indent_style = space
indent_size = 2

[*.{conf,cfg,ini}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
